#!/bin/bash
# info: change devit port
# options: port
#
# Function will change devit port

#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
port=$1

if [ -z "$devit" ]; then
    devit="/usr/local/devit"
fi

# Get current devit port by reading nginx.conf
oldport=$(grep 'listen' $devit/nginx/conf/nginx.conf | awk '{print $2}' | sed "s|;||")
if [ -z "$oldport" ]; then
    oldport=8083
fi

# Includes
source $devit/func/main.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking permissions
if [ "$(id -u)" != '0' ]; then
    check_result $E_FORBIDEN "You must be root to execute this script"
fi

check_args '1' "$#" 'PORT'
is_int_format_valid "$port" 'port number'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

sed -i "s|$oldport;|$port;|g" $devit/nginx/conf/nginx.conf
if [ -f "/etc/roundcube/plugins/password/config.inc.php" ]; then
    sed -i "s|'$oldport'|'$port'|g" /etc/roundcube/plugins/password/config.inc.php
fi
sed -i "s|'$oldport'|'$port'|g" $devit/data/firewall/rules.conf
$devit/bin/v-update-firewall
systemctl restart fail2ban.service
sed -i "s| $oldport | $port |g" /etc/iptables.rules
systemctl restart devit

#----------------------------------------------------------#
#                       devit                              #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit 0;
