#!/bin/bash
# info: delete devit softaculous
# options: NONE
#
# The script disables softaculous plugin


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Includes
source $devit/func/main.sh
source $devit/conf/devit.conf


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$SOFTACULOUS" = 'no' ] || [ -z "$SOFTACULOUS" ]; then
    exit
fi


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Deleting symlink
if [ -e "$devit/web/softaculous" ]; then
    mkdir -p $devit/disabled_plugins
    mv $devit/web/softaculous $devit/disabled_plugins
fi

# Updating SOFTACULOUS value
sed -i "s/SOFTACULOUS.*/SOFTACULOUS='no'/g" \
        $devit/conf/devit.conf


#----------------------------------------------------------#
#                       devit                              #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
