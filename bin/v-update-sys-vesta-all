#!/bin/bash
# info: update all devit packages
# options: USER [RESTART]
#
# The function of updating all devit packages


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Importing system variables
source /etc/profile

# Includes
source $devit/func/main.sh
source $devit/conf/devit.conf


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Starting update loop
for package in devit devit-nginx devit-php devit-ioncube devit-softaculous; do
    $BIN/v-update-sys-devit "$package"
done

#----------------------------------------------------------#
#                       devit                              #
#----------------------------------------------------------#

exit
