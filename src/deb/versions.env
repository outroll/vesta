# Shared upstream version pins for the compiled vesta-nginx/vesta-php
# packages and the vesta-ioncube loader that must match PHP's ABI.
# Sourced by src/deb/{nginx,php,ioncube}/build.sh -- bump here, not in
# the individual scripts, so nginx/php/ioncube can't drift out of sync.

NGINX_VERSION="1.30.4"

# PHP is pinned separately per OS target because they dynamically link
# against the host's libcurl, and PHP 8.4 raised its minimum required
# libcurl to 7.61.0 -- Ubuntu 18.04 only ships 7.58.0, so bionic is capped
# below that bump. PHP 8.3 is the newest branch that still satisfies
# bionic's libcurl (security support until 2027-12-31, vs 8.2's
# 2026-12-31), so it's used there instead of falling further back to 8.2.
# focal (20.04) and jammy (22.04) both ship libcurl >= 7.61.0, so they (like
# noble) have no such ceiling and share the "latest" pin below.
PHP_VERSION_BIONIC="8.3.33"
PHP_VERSION_NOBLE="8.5.9"
