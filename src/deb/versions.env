# Shared upstream version pins for the compiled vesta-nginx/vesta-php
# packages and the vesta-ioncube loader that must match PHP's ABI.
# Sourced by src/deb/{nginx,php,ioncube}/build.sh -- bump here, not in
# the individual scripts, so nginx/php/ioncube can't drift out of sync.

NGINX_VERSION="1.27.4"
PHP_VERSION="8.2.27"
