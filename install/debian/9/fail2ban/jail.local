[ssh-iptables]
enabled  = true
filter   = sshd
action   = devit[name=SSH]
logpath  = /var/log/auth.log
maxretry = 5

[vsftpd-iptables]
enabled  = false
filter   = vsftpd
action   = devit[name=FTP]
logpath  = /var/log/vsftpd.log
maxretry = 5

[exim-iptables]
enabled = true
filter  = exim
action  = devit[name=MAIL]
logpath = /var/log/exim4/mainlog

[dovecot-iptables]
enabled = true
filter  = dovecot
action  = devit[name=MAIL]
logpath = /var/log/dovecot.log

[mysqld-iptables]
enabled  = false
filter   = mysqld-auth
action   = devit[name=DB]
logpath  = /var/log/mysql.log
maxretry = 5

[devit-iptables]
enabled = true
filter  = devit
action  = devit[name=devit]
logpath = /var/log/devit/auth.log
maxretry = 5
